<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Download worker runs as a foreground service to survive long CDN transfers -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-feature android:name="android.hardware.camera.any" />

    <!-- Required for ACTION_VIEW intents on Android 11+ (API 30+) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

    <application
        android:name=".HospitalApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.HospitalManagement"
        tools:targetApi="31">

        <!-- Splash Screen - New Launcher -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HospitalManagement.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.auth.ChangePasswordActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.auth.AuthCodeVerificationActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HospitalManagement" />
        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HospitalManagement" />
        <activity
            android:name=".ui.auth.RegisterOtpActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HospitalManagement" />
        <activity
            android:name=".ui.auth.ForgotPasswordActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HospitalManagement" />
        <activity
            android:name=".ui.auth.ForgotPasswordOtpActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HospitalManagement" />
        <activity
            android:name=".ui.auth.ForgotPasswordResetActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HospitalManagement" />
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HospitalManagement" />
        <activity
            android:name=".ui.profile.SessionsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HospitalManagement" />
        <activity
            android:name=".ui.profile.ChangePasswordSettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HospitalManagement" />
        <activity
            android:name=".ui.profile.NotificationsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HospitalManagement" />
        <activity
            android:name=".ui.folders.FileViewerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.HospitalManagement" />
        <activity android:name=".ui.dashboard.DashboardActivity" android:exported="false" />
        <activity android:name=".ui.admission.AdmissionActivity" android:exported="false" />
        <activity
            android:name=".ui.scanner.ScannerActivity"
            android:exported="false"
            android:theme="@style/Theme.HospitalManagement.Transparent" />
        <activity android:name=".ui.upload.UploadActivity" android:exported="false" />
        <activity android:name=".ui.patients.PatientListActivity" android:exported="false" />
        <activity android:name=".ui.patients.PatientDetailsActivity" android:exported="false" />
        <activity android:name=".ui.folders.FolderViewActivity" android:exported="false" />
        <activity android:name=".ui.folders.FolderDetailsActivity" android:exported="false" />

        <!-- FileProvider for sharing local files with external apps -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".services.HmsFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>

        <!-- WorkManager foreground service override — DownloadWorker runs as a
             foreground service to survive long CDN transfers. API 34+ requires
             an explicit foregroundServiceType; "dataSync" matches the
             FOREGROUND_SERVICE_DATA_SYNC permission declared above. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Handles Cancel / Retry actions fired from download notifications -->
        <receiver
            android:name=".utils.DownloadActionReceiver"
            android:exported="false" />

    </application>

</manifest>
