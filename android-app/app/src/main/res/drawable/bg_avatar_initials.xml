<?xml version="1.0" encoding="utf-8"?>
<!--
     Gradient circle used as fallback when a hospital has no logo. Solid
     brand gradient so white initials are always readable. Runtime code can
     override the background programmatically to vary the gradient per name.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="135"
        android:startColor="@color/brand_primary"
        android:endColor="@color/brand_accent" />
</shape>
