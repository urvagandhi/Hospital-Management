<?xml version="1.0" encoding="utf-8"?>
<com.hospital.management.ui.components.GlassCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.Card.Clickable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_xs"
    android:layout_marginHorizontal="@dimen/space_xs"
    app:cardCornerRadius="@dimen/radius_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_md"
        android:gravity="center_vertical">

        <!-- File type icon -->
        <View
            android:id="@+id/fileIconBg"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_stat_card_icon" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="-31dp"
            android:src="@drawable/ic_file_document"
            app:tint="@color/brand_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/space_md">

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="file_name.pdf"
                android:textSize="14sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/color_on_surface"
                android:maxLines="1"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/tvFileSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.2 MB"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/color_on_surface_muted"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_more_vert"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/space_sm"
            app:tint="@color/color_on_surface_muted" />
    </LinearLayout>
</com.hospital.management.ui.components.GlassCardView>
