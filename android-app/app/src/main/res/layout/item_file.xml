<?xml version="1.0" encoding="utf-8"?>
<com.hospital.management.ui.components.GlassCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.Card.Clickable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_sm"
    android:layout_marginHorizontal="@dimen/space_xs"
    app:cardCornerRadius="@dimen/radius_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/space_base"
        android:gravity="center_vertical">

        <!-- File type icon with colored background -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <View
                android:id="@+id/fileIconBg"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_stat_card_icon" />

            <ImageView
                android:id="@+id/ivFileIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_file_document"
                app:tint="@color/brand_primary" />

            <ImageView
                android:id="@+id/ivThumbnail"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/space_md">

            <TextView
                android:id="@+id/tvFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="file_name.pdf"
                android:textSize="14sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/color_on_surface"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvFileSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.2 MB"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                android:textColor="@color/color_on_surface_muted"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_more_vert"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/space_sm"
            app:tint="@color/color_on_surface_variant" />
    </LinearLayout>
</com.hospital.management.ui.components.GlassCardView>
