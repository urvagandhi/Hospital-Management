<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Gradient blob background -->
        <com.hospital.management.ui.components.GradientBlobBackground
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/space_xl"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Logo and Title Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_sm"
                android:fontFamily="@font/inter_bold"
                android:text="Hospital Management"
                android:textColor="@color/color_on_surface"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xl"
                android:fontFamily="@font/inter"
                android:text="Verify Your Identity"
                android:textColor="@color/color_on_surface_variant"
                android:textSize="14sp" />

            <!-- Info Card using GlassCardView -->
            <com.hospital.management.ui.components.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_base">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_xs"
                        android:fontFamily="@font/inter_semibold"
                        android:text="OTP Sent Successfully"
                        android:textColor="@color/brand_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:text="We've sent a 6-digit code to your registered phone"
                        android:textColor="@color/brand_primary"
                        android:textSize="13sp" />
                </LinearLayout>
            </com.hospital.management.ui.components.GlassCardView>

            <!-- Error Message -->
            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_base"
                android:background="@color/color_surface_variant"
                android:fontFamily="@font/inter"
                android:padding="@dimen/space_md"
                android:textColor="@color/brand_destructive"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- OTP Input Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginBottom="@dimen/space_md"
                android:fontFamily="@font/inter_semibold"
                android:text="Enter 6-Digit OTP"
                android:textColor="@color/color_on_surface"
                android:textSize="14sp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.App.TextInputLayout.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="••••••">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOtp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:inputType="number"
                    android:letterSpacing="0.5"
                    android:maxLength="6"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Verify Button -->
            <Button
                android:id="@+id/btnVerify"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:layout_marginTop="@dimen/space_xl"
                android:fontFamily="@font/inter_medium"
                android:text="Verify OTP"
                android:textSize="16sp" />

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_base"
                android:visibility="gone" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_xl"
                android:layout_marginBottom="@dimen/space_xl"
                android:background="@color/color_divider" />

            <!-- Resend Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter"
                    android:text="Didn't receive code?"
                    android:textColor="@color/color_on_surface_variant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="Resend in 30s"
                    android:textColor="@color/color_on_surface_muted"
                    android:textSize="13sp"
                    android:visibility="visible" />
            </LinearLayout>

            <Button
                android:id="@+id/btnResend"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:enabled="false"
                android:fontFamily="@font/inter_medium"
                android:text="Resend OTP"
                android:textSize="14sp" />

            <!-- Back to Login -->
            <Button
                android:id="@+id/btnBackToLogin"
                style="@style/Widget.App.Button.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_base"
                android:fontFamily="@font/inter_medium"
                android:text="Back to Login"
                android:textSize="13sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
