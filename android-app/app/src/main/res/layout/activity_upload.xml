<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <com.hospital.management.ui.components.GradientBlobBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- App Bar -->
    <View
        android:id="@+id/viewHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/space_sm"
        android:layout_marginStart="@dimen/space_md"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_arrow_back"
        android:contentDescription="Back"
        app:tint="@color/color_on_surface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Upload Documents"
        android:textColor="@color/color_on_surface"
        android:textSize="20sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="@font/inter_semibold"
        android:letterSpacing="-0.01"
        android:layout_marginEnd="@dimen/space_sm"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toStartOf="@id/tvPageCount" />

    <TextView
        android:id="@+id/tvPageCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 pages scanned"
        android:textColor="@color/color_on_surface_muted"
        android:textSize="13sp"
        android:fontFamily="@font/inter"
        android:layout_marginEnd="@dimen/space_base"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvTitle" />

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/viewHeader"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_lg"
            android:paddingTop="@dimen/space_lg"
            android:paddingBottom="@dimen/space_2xl">

            <!-- Main Preview Card -->
            <com.hospital.management.ui.components.GlassCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_base">

                <ImageView
                    android:id="@+id/ivPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/preview_min_height"
                    android:maxHeight="320dp"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    android:background="@color/color_surface_variant" />
            </com.hospital.management.ui.components.GlassCardView>

            <!-- Page Thumbnails -->
            <TextView
                android:id="@+id/tvPagesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pages (drag to reorder)"
                android:textColor="@color/color_on_surface_variant"
                android:textSize="13sp"
                android:fontFamily="@font/inter"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/space_sm" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/space_lg" />

            <!-- Filename Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilFileName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="File name (optional)"
                app:boxStrokeColor="@color/brand_primary"
                app:hintTextColor="@color/brand_primary"
                app:helperText="Leave empty for auto-generated name"
                app:helperTextTextColor="@color/color_on_surface_muted"
                android:layout_marginBottom="@dimen/space_base">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Upload Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUpload"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:text="Upload Documents"
                app:icon="@drawable/ic_upload"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/space_md"
                app:iconTint="@android:color/white" />

            <!-- Upload Progress -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="@dimen/space_base">

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:indeterminateTint="@color/brand_primary"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvUploadProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Uploading..."
                    android:textColor="@color/color_on_surface_variant"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:layout_marginStart="@dimen/space_sm"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
