<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- Gradient Blob Background -->
    <com.hospital.management.ui.components.GradientBlobBackground
        android:id="@+id/blobBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Top section that gets status bar inset padding -->
    <LinearLayout
        android:id="@+id/layoutTopSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="@dimen/avatar_size_sm"
                    android:layout_height="@dimen/avatar_size_sm">

                    <TextView
                        android:id="@+id/tvToolbarInitials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_initials"
                        android:gravity="center"
                        android:textColor="@android:color/white"
                        android:fontFamily="@font/inter_bold"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeStepGranularity="1sp"
                        android:text="H"
                        android:visibility="gone" />

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivToolbarLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        app:civ_border_width="@dimen/glass_stroke_width"
                        app:civ_border_color="@color/color_glass_stroke" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvToolbarHospitalName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hospital"
                    android:textColor="@color/color_on_surface"
                    android:textSize="17sp"
                    android:fontFamily="@font/inter_semibold"
                    android:layout_marginStart="@dimen/space_md"
                    android:layout_marginEnd="@dimen/space_xl"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <!-- Background activity banner — shows in-flight downloads/uploads/sync -->
        <include layout="@layout/view_work_progress_banner" />

        <!-- Stats Row -->
        <LinearLayout
            android:id="@+id/layoutStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_base"
            android:layout_marginTop="@dimen/space_sm">

            <!-- Total Patients Card (Glass) -->
            <com.hospital.management.ui.components.GlassCardView
                android:id="@+id/cardTotalPatients"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/elevation_card"
                app:strokeWidth="@dimen/glass_stroke_width"
                app:strokeColor="@color/color_glass_stroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/stat_card_min_height"
                    android:orientation="vertical"
                    android:padding="@dimen/space_base"
                    android:clipToPadding="false">

                    <!-- Icon -->
                    <FrameLayout
                        android:layout_width="@dimen/icon_container_sm"
                        android:layout_height="@dimen/icon_container_sm">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_stat_card_icon" />

                        <ImageView
                            android:layout_width="@dimen/icon_size_sm"
                            android:layout_height="@dimen/icon_size_sm"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_people"
                            app:tint="@color/brand_primary"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <!-- Count -->
                    <TextView
                        android:id="@+id/tvPatientCount"
                        android:layout_marginTop="@dimen/space_base"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="28sp"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@color/color_on_surface"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <!-- Label -->
                    <TextView
                        android:id="@+id/lblPatients"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total Patients"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@color/color_on_surface"
                        android:alpha="0.6"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </com.hospital.management.ui.components.GlassCardView>

            <!-- New Admission Card (Primary) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnNewAdmission"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="@dimen/elevation_card"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/brand_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/stat_card_min_height"
                    android:orientation="vertical"
                    android:padding="@dimen/space_base"
                    android:clipToPadding="false">

                    <FrameLayout
                        android:layout_width="@dimen/icon_container_sm"
                        android:layout_height="@dimen/icon_container_sm">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_circle_white_alpha" />

                        <ImageView
                            android:layout_width="@dimen/icon_size_sm"
                            android:layout_height="@dimen/icon_size_sm"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_add"
                            app:tint="@android:color/white"
                            android:contentDescription="@null" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_base"
                        android:text="New"
                        android:textSize="18sp"
                        android:fontFamily="@font/inter_bold"
                        android:textColor="@android:color/white"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="1dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Admission"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter_medium"
                            android:textColor="@android:color/white"
                            android:alpha="0.85"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <ImageView
                            android:layout_width="@dimen/icon_size_sm"
                            android:layout_height="@dimen/icon_size_sm"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@android:color/white"
                            android:alpha="0.7"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <!-- Section Divider -->
    <View
        android:id="@+id/dividerSection"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="@dimen/space_xl"
        android:layout_marginTop="@dimen/space_lg"
        android:background="@color/color_divider"
        app:layout_constraintTop_toBottomOf="@id/layoutTopSection" />

    <!-- Section Header -->
    <TextView
        android:id="@+id/tvQuickActions"
        style="@style/TextAppearance.App.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recent Patients"
        android:textColor="@color/color_on_surface"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_base"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/dividerSection" />

    <!-- Search (Glass) -->
    <com.hospital.management.ui.components.GlassCardView
        android:id="@+id/cardSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_base"
        android:layout_marginTop="@dimen/space_md"
        app:cardCornerRadius="@dimen/radius_md"
        app:cardElevation="@dimen/elevation_card"
        app:strokeWidth="@dimen/glass_stroke_width"
        app:strokeColor="@color/color_glass_stroke"
        app:layout_constraintTop_toBottomOf="@id/tvQuickActions">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:iconifiedByDefault="false"
            app:queryBackground="@android:color/transparent"
            app:queryHint="Search by name or PatientID..."
            android:background="@null" />
    </com.hospital.management.ui.components.GlassCardView>

    <!-- Patient List -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_sm"
        app:layout_constraintTop_toBottomOf="@id/cardSearch"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPatients"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_base"
                android:clipToPadding="false" />

            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center"
                android:visibility="gone">

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_circle_light"
                    android:layout_marginBottom="@dimen/space_base">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_people"
                        android:contentDescription="@null"
                        app:tint="@color/brand_primary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No patients found"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/color_on_surface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap + to add your first patient"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/color_on_surface_muted"
                    android:layout_marginTop="@dimen/space_xs" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/brand_primary"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
