<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fitsSystemWindows="true">

    <!-- Gradient Blob Background -->
    <com.hospital.management.ui.components.GradientBlobBackground
        android:id="@+id/blobBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivToolbarLogo"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@mipmap/ic_launcher_round"
                app:civ_border_width="@dimen/glass_stroke_width"
                app:civ_border_color="@color/color_glass_stroke" />

            <TextView
                android:id="@+id/tvToolbarHospitalName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hospital"
                android:textColor="@color/color_on_surface"
                android:textSize="17sp"
                android:fontFamily="@font/inter_semibold"
                android:layout_marginStart="@dimen/space_md" />
        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- Stats Row -->
    <LinearLayout
        android:id="@+id/layoutStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_base"
        android:layout_marginTop="@dimen/space_md"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <!-- Total Patients Card (Glass) -->
        <com.hospital.management.ui.components.GlassCardView
            android:id="@+id/cardTotalPatients"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardCornerRadius="@dimen/radius_xl"
            app:cardElevation="@dimen/elevation_card"
            app:strokeWidth="@dimen/glass_stroke_width"
            app:strokeColor="@color/color_glass_stroke">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="14dp">

                <View
                    android:id="@+id/iconBgPatients"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_stat_card_icon"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="@dimen/icon_size_sm"
                    android:layout_height="@dimen/icon_size_sm"
                    android:src="@drawable/ic_people"
                    app:tint="@color/brand_primary"
                    android:contentDescription="@null"
                    app:layout_constraintStart_toStartOf="@id/iconBgPatients"
                    app:layout_constraintEnd_toEndOf="@id/iconBgPatients"
                    app:layout_constraintTop_toTopOf="@id/iconBgPatients"
                    app:layout_constraintBottom_toBottomOf="@id/iconBgPatients" />

                <TextView
                    android:id="@+id/tvPatientCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="26sp"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="@color/color_on_surface"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/lblPatients" />

                <TextView
                    android:id="@+id/lblPatients"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Patients"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/color_on_surface_variant"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.hospital.management.ui.components.GlassCardView>

        <!-- New Admission Card (Primary) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnNewAdmission"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardCornerRadius="@dimen/radius_xl"
            app:cardElevation="@dimen/elevation_card"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/brand_primary">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="14dp">

                <View
                    android:id="@+id/iconBgAdd"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_white_alpha"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:layout_width="@dimen/icon_size_sm"
                    android:layout_height="@dimen/icon_size_sm"
                    android:src="@drawable/ic_add"
                    app:tint="@android:color/white"
                    android:contentDescription="@null"
                    app:layout_constraintStart_toStartOf="@id/iconBgAdd"
                    app:layout_constraintEnd_toEndOf="@id/iconBgAdd"
                    app:layout_constraintTop_toTopOf="@id/iconBgAdd"
                    app:layout_constraintBottom_toBottomOf="@id/iconBgAdd" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New\nAdmission"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter_semibold"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@android:color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageView
                    android:layout_width="@dimen/icon_size_sm"
                    android:layout_height="@dimen/icon_size_sm"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/color_ripple_white"
                    android:contentDescription="@null"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Section Header -->
    <TextView
        android:id="@+id/tvQuickActions"
        style="@style/TextAppearance.App.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recent Patients"
        android:textColor="@color/color_on_surface"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_xl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutStats" />

    <!-- Search (Glass) -->
    <com.hospital.management.ui.components.GlassCardView
        android:id="@+id/cardSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_base"
        android:layout_marginTop="@dimen/space_md"
        app:cardCornerRadius="@dimen/radius_md"
        app:cardElevation="@dimen/elevation_card"
        app:strokeWidth="@dimen/glass_stroke_width"
        app:strokeColor="@color/color_glass_stroke"
        app:layout_constraintTop_toBottomOf="@id/tvQuickActions">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/searchView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:iconifiedByDefault="false"
            app:queryBackground="@android:color/transparent"
            app:queryHint="Search by name or MRN..."
            android:background="@null" />
    </com.hospital.management.ui.components.GlassCardView>

    <!-- Patient List -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_sm"
        app:layout_constraintTop_toBottomOf="@id/cardSearch"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPatients"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/space_md"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_base"
                android:clipToPadding="false" />

            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center"
                android:visibility="gone">

                <View
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circle_light"
                    android:layout_marginBottom="@dimen/space_base" />

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No patients found"
                    android:textSize="15sp"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/color_on_surface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap + to add your first patient"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/color_on_surface_muted"
                    android:layout_marginTop="@dimen/space_xs" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/brand_primary"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
