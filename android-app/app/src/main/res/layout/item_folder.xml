<?xml version="1.0" encoding="utf-8"?>
<com.hospital.management.ui.components.GlassCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.Card.Clickable"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_xs"
    app:cardCornerRadius="@dimen/radius_lg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_base">

        <!-- Icon + Badge Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/iconBg"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_folder_icon" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="-33dp"
                android:src="@drawable/ic_folder"
                app:tint="@color/brand_primary" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvFileCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 files"
                android:textSize="11sp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/color_on_surface_muted"
                android:background="@drawable/bg_badge"
                android:paddingHorizontal="@dimen/space_sm"
                android:paddingVertical="@dimen/space_xs"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Folder Name -->
        <TextView
            android:id="@+id/tvFolderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Folder Name"
            android:textSize="13sp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="@color/color_on_surface"
            android:layout_marginTop="@dimen/space_md"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>
</com.hospital.management.ui.components.GlassCardView>
