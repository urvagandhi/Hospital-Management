<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".ui.auth.TotpSetupActivity">

        <!-- Gradient blob background -->
        <com.hospital.management.ui.components.GradientBlobBackground
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Main glass card wrapping all content -->
        <com.hospital.management.ui.components.GlassCardView
            android:id="@+id/glassCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/space_base"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.0"
            android:layout_marginTop="@dimen/space_2xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_xl">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:text="Set Up Two-Factor Authentication"
                    android:textColor="@color/color_on_surface"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tvInstruction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:fontFamily="@font/inter"
                    android:text="Scan the QR code with your authenticator app (Google Authenticator, Authy, etc.)"
                    android:textColor="@color/color_on_surface_variant"
                    android:textSize="14sp" />

                <!-- QR Code centered -->
                <ImageView
                    android:id="@+id/ivQrCode"
                    android:layout_width="250dp"
                    android:layout_height="250dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_xl"
                    android:contentDescription="QR Code for 2FA setup"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/tvManualKeyLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_base"
                    android:fontFamily="@font/inter"
                    android:text="Or enter this key manually:"
                    android:textColor="@color/color_on_surface_variant"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvManualKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:fontFamily="monospace"
                    android:textColor="@color/color_on_surface"
                    android:textIsSelectable="true"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTotpCode"
                    style="@style/Widget.App.TextInputLayout.Glass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:hint="Enter 6-digit code">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTotpCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:inputType="number"
                        android:maxLength="6"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnVerify"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_base"
                    android:fontFamily="@font/inter_medium"
                    android:text="Verify and Continue"
                    android:textSize="16sp" />

                <!-- Backup codes card using GlassCardView -->
                <com.hospital.management.ui.components.GlassCardView
                    android:id="@+id/cardBackupCodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xl"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/space_base">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_semibold"
                            android:text="Backup Codes"
                            android:textColor="@color/color_on_surface"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:fontFamily="@font/inter"
                            android:text="Save these codes in a safe place. You can use them to log in if you lose access to your authenticator app."
                            android:textColor="@color/color_on_surface_variant"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvBackupCodes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_md"
                            android:fontFamily="monospace"
                            android:textColor="@color/color_on_surface"
                            android:textIsSelectable="true"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/btnCopyBackupCodes"
                            style="@style/Widget.App.Button.Ghost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_sm"
                            android:fontFamily="@font/inter_medium"
                            android:text="Copy to Clipboard" />
                    </LinearLayout>
                </com.hospital.management.ui.components.GlassCardView>

                <Button
                    android:id="@+id/btnContinueToDashboard"
                    style="@style/Widget.App.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="@dimen/space_base"
                    android:fontFamily="@font/inter_medium"
                    android:text="Continue to Dashboard"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_base"
                    android:layout_marginBottom="@dimen/space_2xl"
                    android:visibility="gone" />

            </LinearLayout>
        </com.hospital.management.ui.components.GlassCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
