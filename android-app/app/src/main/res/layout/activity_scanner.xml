<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <com.hospital.management.ui.components.GradientBlobBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Scanner Icon -->
    <com.hospital.management.ui.components.GlassCardView
        android:id="@+id/iconContainer"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:glass_corner_radius="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.35">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_scanner"
            app:tint="@color/brand_primary" />
    </com.hospital.management.ui.components.GlassCardView>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:text="Document Scanner"
        android:textColor="@color/color_on_surface"
        android:textSize="28sp"
        android:fontFamily="@font/inter_bold"
        android:letterSpacing="-0.02"
        app:layout_constraintTop_toBottomOf="@id/iconContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_md"
        android:layout_marginHorizontal="@dimen/space_3xl"
        android:text="Scan multiple pages with automatic edge detection, cropping, and enhancement"
        android:textColor="@color/color_on_surface_variant"
        android:textSize="15sp"
        android:fontFamily="@font/inter"
        android:textAlignment="center"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Feature Chips -->
    <LinearLayout
        android:id="@+id/featurePills"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Multi-Page"
            android:textColor="@color/color_on_surface_variant"
            android:textSize="12sp"
            android:fontFamily="@font/inter_medium"
            android:background="@drawable/bg_glass_input"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="@dimen/space_sm"
            android:layout_marginEnd="@dimen/space_sm" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Auto Crop"
            android:textColor="@color/color_on_surface_variant"
            android:textSize="12sp"
            android:fontFamily="@font/inter_medium"
            android:background="@drawable/bg_glass_input"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="@dimen/space_sm"
            android:layout_marginEnd="@dimen/space_sm" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enhance"
            android:textColor="@color/color_on_surface_variant"
            android:textSize="12sp"
            android:fontFamily="@font/inter_medium"
            android:background="@drawable/bg_glass_input"
            android:paddingHorizontal="@dimen/space_md"
            android:paddingVertical="@dimen/space_sm" />
    </LinearLayout>

    <!-- Buttons -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartScan"
        style="@style/Widget.App.Button.Primary"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height"
        android:layout_marginHorizontal="@dimen/space_2xl"
        android:layout_marginBottom="@dimen/space_base"
        android:text="Start Scanning"
        app:icon="@drawable/ic_scanner"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/space_md"
        app:iconTint="@android:color/white"
        app:layout_constraintBottom_toTopOf="@id/btnCancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.App.Button.Ghost"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_height"
        android:layout_marginBottom="@dimen/space_2xl"
        android:text="Cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
