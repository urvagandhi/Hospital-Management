<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <com.hospital.management.ui.components.GradientBlobBackground
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top section with status bar insets -->
    <LinearLayout
        android:id="@+id/layoutTopSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <!-- App Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_xs">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/ic_chevron_right"
                android:rotation="180"
                android:contentDescription="Back"
                app:tint="@color/color_on_surface" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patient Folders"
                android:textColor="@color/color_on_surface"
                android:textSize="20sp"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="-0.01" />
        </LinearLayout>

        <!-- Patient Info Card - Gradient Header -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvPatientInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/space_base"
            android:layout_marginBottom="@dimen/space_sm"
            app:cardCornerRadius="@dimen/radius_xl"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Gradient header section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_patient_header_gradient"
                    android:orientation="horizontal"
                    android:padding="@dimen/space_base"
                    android:gravity="center_vertical">

                    <!-- Avatar with initials -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardCornerRadius="@dimen/radius_md"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/white_alpha_20"
                        app:strokeWidth="0dp">

                        <TextView
                            android:id="@+id/tvPatientInitials"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="PD"
                            android:gravity="center"
                            android:textColor="@android:color/white"
                            android:textSize="17sp"
                            android:fontFamily="@font/inter_bold"
                            android:includeFontPadding="false" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Name + PatientID -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="@dimen/space_md">

                        <TextView
                            android:id="@+id/tvPatientName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Patient Name"
                            android:textColor="@android:color/white"
                            android:textSize="18sp"
                            android:fontFamily="@font/inter_bold"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:id="@+id/tvPatientId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@android:color/white"
                            android:alpha="0.8"
                            android:textSize="13sp"
                            android:fontFamily="@font/inter_medium"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Edit Button -->
                    <ImageButton
                        android:id="@+id/btnEditPatient"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_circle_white_alpha"
                        android:src="@android:drawable/ic_menu_edit"
                        app:tint="@android:color/white"
                        android:padding="@dimen/space_sm" />
                </LinearLayout>

                <!-- Remarks / description row (hidden when empty) -->
                <LinearLayout
                    android:id="@+id/layoutRemarks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/color_surface_elevated"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/space_base"
                    android:paddingVertical="@dimen/space_sm"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remarks"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter_semibold"
                        android:textAllCaps="true"
                        android:letterSpacing="0.06"
                        android:textColor="@color/color_on_surface_variant" />

                    <TextView
                        android:id="@+id/tvPatientRemarks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/inter"
                        android:textSize="13sp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="@color/color_on_surface" />
                </LinearLayout>

                <!-- Spacer below gradient -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_sm"
                    android:background="@color/color_surface_elevated" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Folders Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFolders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_sm"
        android:paddingHorizontal="10dp"
        android:paddingTop="@dimen/space_xs"
        android:paddingBottom="88dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/layoutTopSection"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No folders available"
        android:textSize="15sp"
        android:fontFamily="@font/inter_medium"
        android:textColor="@color/color_on_surface_variant"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@+id/rvFolders"
        app:layout_constraintBottom_toBottomOf="@+id/rvFolders"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/brand_primary"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@+id/rvFolders"
        app:layout_constraintBottom_toBottomOf="@+id/rvFolders"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- FABs -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreateFolder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_lg"
        android:src="@android:drawable/ic_input_add"
        app:tint="@android:color/white"
        app:backgroundTint="@color/brand_primary"
        app:fabSize="normal"
        app:shapeAppearance="@style/ShapeAppearance.App.MediumComponent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabDownloadAll"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_lg"
        android:src="@android:drawable/stat_sys_download"
        app:tint="@android:color/white"
        app:backgroundTint="@color/brand_success"
        app:fabSize="mini"
        app:shapeAppearance="@style/ShapeAppearance.App.SmallComponent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/fabCreateFolder" />

</androidx.constraintlayout.widget.ConstraintLayout>
