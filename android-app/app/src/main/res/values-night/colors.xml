<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ═══════════════════════════════════════════════════════
         BACKWARD-COMPAT COLOR ALIASES — DARK MODE
         Maps old color names → new dark design token values
         ═══════════════════════════════════════════════════════ -->

    <!-- Brand aliases (keep consistent with light — brand is invariant) -->
    <color name="primary">@color/brand_primary</color>
    <color name="primary_dark">@color/brand_primary_variant</color>
    <color name="primary_light">#60A5FA</color>
    <color name="primary_lighter">#1E3A5F</color>

    <color name="accent">@color/brand_accent</color>
    <color name="accent_dark">#0284C7</color>
    <color name="accent_light">#38BDF8</color>

    <!-- Gradient Colors -->
    <color name="gradient_start">@color/brand_primary</color>
    <color name="gradient_center">#8B5CF6</color>
    <color name="gradient_end">#EC4899</color>
    <color name="gradient_accent_start">#22D3EE</color>
    <color name="gradient_accent_end">#34D399</color>

    <!-- Card Gradient Colors -->
    <color name="card_gradient_blue_start">#3B82F6</color>
    <color name="card_gradient_blue_end">#1E40AF</color>
    <color name="card_gradient_purple_start">#8B5CF6</color>
    <color name="card_gradient_purple_end">#5B21B6</color>
    <color name="card_gradient_cyan_start">#22D3EE</color>
    <color name="card_gradient_cyan_end">#0E7490</color>
    <color name="card_gradient_amber_start">#FBBF24</color>
    <color name="card_gradient_amber_end">#B45309</color>

    <!-- Surface aliases → dark tokens -->
    <color name="background">@color/color_background</color>
    <color name="surface">@color/color_surface_elevated</color>
    <color name="surface_variant">@color/color_surface_variant</color>
    <color name="surface_elevated">@color/color_surface_elevated</color>

    <!-- Text aliases → dark tokens -->
    <color name="text_primary">@color/color_on_surface</color>
    <color name="text_secondary">@color/color_on_surface_variant</color>
    <color name="text_hint">@color/color_on_surface_muted</color>
    <color name="text_inverse">#0F172A</color>

    <!-- Semantic aliases → dark tokens (use brighter variants for dark bg) -->
    <color name="success">#34D399</color>
    <color name="success_light">#064E3B</color>
    <color name="error">#F87171</color>
    <color name="error_light">#7F1D1D</color>
    <color name="warning">#FBBF24</color>
    <color name="warning_light">#78350F</color>
    <color name="info">#60A5FA</color>

    <!-- UI aliases → dark tokens -->
    <color name="gray">@color/color_on_surface_variant</color>
    <color name="divider">@color/color_divider</color>
    <color name="border">@color/color_glass_stroke</color>
    <color name="border_focus">@color/brand_primary</color>

</resources>
