{
  "name": "mymedivault-backend",
  "version": "1.0.0",
  "description": "MyMediVault Backend - Login & OTP Verification",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "build": "npm install --production",
    "ci": "npm ci",
    "start": "NODE_ENV=production LOG_PRETTY=true node src/index.js",
    "start:prod": "NODE_ENV=production LOG_PRETTY=true node src/index.js",
    "start:prod:json": "NODE_ENV=production node src/index.js",
    "start:prod:pretty": "NODE_ENV=production LOG_PRETTY=true node src/index.js",
    "prod": "npm run start:prod",
    "dev": "LOG_PRETTY=true nodemon",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "keywords": [
    "hospital",
    "management",
    "authentication",
    "otp"
  ],
  "author": "Hospital Team",
  "license": "MIT",
  "overrides": {
    "uuid": "^14.0.0",
    "@tootallnate/once": "^3.0.1",
    "http-proxy-agent": "^7.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.932.0",
    "@aws-sdk/s3-request-presigner": "^3.932.0",
    "ioredis": "^5.4.1",
    "@upstash/redis": "^1.37.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.0",
    "firebase-admin": "^13.8.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.6.1",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^2.2.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.1.3"
  },
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "src/__tests__/auth.controller.test.js"
    ]
  }
}
