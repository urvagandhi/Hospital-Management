# MediVault — Environment Variables
#
# THIS FILE'S ROLE in the production Docker setup:
#   .env (this file)               — vars used by docker-compose.yml itself
#                                     (Mongo password, Vite build args, etc.)
#   backend/.env                   — Express API secrets (JWT, Cloudinary,
#                                     Brevo, Firebase, Upstash, …) — every
#                                     var below from "── Server ──" onward
#                                     belongs in backend/.env, NOT here
#   compression-service/.env       — sidecar secrets (see that file's
#                                     .env.example for the full list)
#
# The compose file picks up THIS .env automatically for ${...} interpolation
# and loads backend/.env + compression-service/.env into their containers via
# `env_file:`. Keep them in three separate files so secrets stay scoped.
#
# NEVER commit any .env file (only .env.example) — gitignored for a reason.
# ══════════════════════════════════════════════════════════════════════════

# ── Docker / Compose interpolation (REQUIRED for `docker compose up`) ──────
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=          # REQUIRED — strong password for MongoDB root
                              # generate: openssl rand -base64 32

# Optional — Vite build-time app name (baked into the SPA bundle)
VITE_APP_NAME=Hospital Management System

# REDIS_PASSWORD is no longer used — Redis stays on Upstash REST for now.
# Local Redis migration is a follow-up workstream (needs backend code patch).
# REDIS_PASSWORD=

# ── Server ──
NODE_ENV=production
PORT=5000

# ── Logging (pino) ──
# Level: trace | debug | info | warn | error | fatal. Default info in prod, debug in dev.
# LOG_LEVEL=info
# LOG_PRETTY=false   # Set true to force human-readable pretty logs (even if NODE_ENV=production)

# ── Database ──
# When using docker-compose this is auto-constructed from MONGO_ROOT_USER/PASSWORD.
# Set this only if using an external MongoDB (e.g. Atlas).
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/hospital-management

# ── JWT ──
# CRITICAL: JWT_SECRET and REFRESH_TOKEN_SECRET MUST be different random strings.
# Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=                   # REQUIRED — random 64+ char string (no 'dev-' prefix)
JWT_EXPIRY=24h
REFRESH_TOKEN_SECRET=         # REQUIRED — random 64+ char string (no 'dev-' prefix)
REFRESH_TOKEN_EXPIRY=365d     # mobile-aware long-lived refresh; 7-day Auth Code re-verify is the real security gate

# ── OTP ──
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6
MAX_OTP_ATTEMPTS=3

# ── Cloudinary (File Storage) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SIGNED_UPLOADS_ENABLED=false  # Enable B5 signed-URL mode for new uploads

# ── Upstash Redis (Serverless) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Brevo (Production Email) ──
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@hospitalhms.com
BREVO_SENDER_NAME=Hospital HMS

# ── Mailtrap (Development Email) ──
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=

# ── Firebase (Push Notifications) ──
# Pick ONE auth path: inline private key, JSON blob, or file path
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=           # Paste the private key with \n escaped
FIREBASE_CLIENT_EMAIL=
FIREBASE_SERVICE_ACCOUNT_JSON=  # Alternative: full service account JSON blob
FIREBASE_SERVICE_ACCOUNT_PATH=  # Alternative: filesystem path to service account JSON

# ── Compression Sidecar ──
USE_COMPRESSION_SERVICE=false
COMPRESSION_SERVICE_URL=        # REQUIRED if USE_COMPRESSION_SERVICE=true
COMPRESSION_SERVICE_SECRET=     # REQUIRED if USE_COMPRESSION_SERVICE=true (shared with sidecar's INTERNAL_API_SECRET)

# ── Proxy / IP trust (for X-Forwarded-For) ──
# Must be a specific integer — `true` is rejected by express-rate-limit.
# Bump to 3 if Sessions shows internal 10.x / 172.16.x IPs after a real login.
TRUST_PROXY_HOPS=2

# ── GeoIP providers ──
# Provider chain is ordered: ipinfo (if IPINFO_TOKEN set) → ip-api.com (keyless fallback).
# ipinfo.io free tier ships 50k lookups/month with a token; sign up at
# https://ipinfo.io/signup. Leave blank to use ip-api.com only (45 req/min/IP).
IPINFO_TOKEN=

# GEOIP_DEV_OVERRIDE_IP forces every lookup to this IP. Useful when testing
# from localhost (otherwise session IPs are ::1/127.0.0.1 → "Local network").
# Unset before shipping.
GEOIP_DEV_OVERRIDE_IP=

# ── CORS ──
FRONTEND_URL=http://localhost:3000

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX_REQUESTS=60

# ── Cloudflare R2 (Legacy File Storage — currently unused; r2.service.js is dead code) ──
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hospital-files

# ── Local File Storage (dev fallback) ──
USE_LOCAL_STORAGE=false
LOCAL_STORAGE_PATH=./uploads

# ── Frontend Build Args (used by docker-compose at build time) ──
VITE_API_URL=/api
VITE_APP_NAME=MediVault
