# ══════════════════════════════════════════════════
# Hospital Management System — Environment Variables
# Copy to .env and fill in production values
# ══════════════════════════════════════════════════

# ── Docker / Infrastructure ──
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=          # REQUIRED — strong password for MongoDB root
REDIS_PASSWORD=               # REQUIRED — strong password for Redis

# ── Server ──
NODE_ENV=production
PORT=5000

# ── Database ──
# When using docker-compose this is auto-constructed from MONGO_ROOT_USER/PASSWORD.
# Set this only if using an external MongoDB (e.g. Atlas).
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/hospital-management

# ── JWT ──
JWT_SECRET=                   # REQUIRED — random 64+ char string (no 'dev-' prefix)
JWT_EXPIRY=24h
REFRESH_TOKEN_SECRET=         # REQUIRED — random 64+ char string (no 'dev-' prefix)
REFRESH_TOKEN_EXPIRY=7d

# ── TOTP 2FA ──
TOTP_ENCRYPTION_KEY=          # REQUIRED — 64-char hex string (32 bytes for AES-256)
TOTP_ISSUER=HospitalManagement
TOTP_WINDOW=1
TOTP_MAX_ATTEMPTS=5
TOTP_LOCK_DURATION_MINUTES=5

# ── Email (SMTP) ──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com
SMTP_SECURE=false

# ── SMS Gateway (placeholder) ──
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER=Hospital

# ── CORS ──
FRONTEND_URL=http://localhost:3000

# ── Rate Limiting ──
RATE_LIMIT_WINDOW_MS=15000
RATE_LIMIT_MAX_REQUESTS=10

# ── Cloudflare R2 (File Storage) ──
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hospital-files

# ── Local File Storage (dev fallback) ──
USE_LOCAL_STORAGE=false
LOCAL_STORAGE_PATH=./uploads

# ── Frontend Build Args (used by docker-compose at build time) ──
# VITE_* vars are baked into the frontend at build time.
VITE_API_URL=/api
VITE_APP_NAME=Hospital Management System
