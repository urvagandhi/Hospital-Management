# ── Compression-service .dockerignore ──
# Files/dirs excluded from the Docker build context to keep the image small,
# the build fast, and secrets out of the layers.

# ── Python bytecode & build artefacts ───────────────────────────────────────
__pycache__
*.pyc
*.pyo
*.pyd
*.egg-info
*.egg
dist
build
.eggs

# ── Virtualenvs (re-created inside the image) ───────────────────────────────
.venv
venv
env

# ── Type / lint / test caches ───────────────────────────────────────────────
.mypy_cache
.pytest_cache
.ruff_cache
.tox
htmlcov
coverage
.coverage
.coverage.*

# ── Tests (not needed at runtime) ───────────────────────────────────────────
tests
test_*.py
*_test.py

# ── Secrets & local environment (NEVER bake into image) ─────────────────────
.env
.env.*
!.env.example

# ── VCS & editor noise ──────────────────────────────────────────────────────
.git
.gitignore
.gitattributes
.vscode
.idea
.DS_Store

# ── Docs & meta (kept in repo, not in image) ────────────────────────────────
README.md
*.md
docs

# ── Logs & local job output ─────────────────────────────────────────────────
*.log
tmp
temp
jobs

# ── Docker artefacts (not needed inside the image) ──────────────────────────
Dockerfile
.dockerignore
