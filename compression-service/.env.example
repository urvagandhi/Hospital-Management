# ══════════════════════════════════════════════════════════════════════════
# MediVault — Compression Sidecar — Environment Variables
# Copy to compression-service/.env and fill in production values.
#
# Loaded by docker-compose into the `compression` container.
# NEVER commit the actual .env file — it's gitignored for a reason.
# ══════════════════════════════════════════════════════════════════════════

# ── Shared secret with the backend (must match COMPRESSION_SERVICE_SECRET in backend/.env) ──
# Generate fresh: openssl rand -hex 32
INTERNAL_API_SECRET=

# ── Cloudinary (sidecar fetches source PDFs and uploads merged result) ──────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── MongoDB ──
# In production this is OVERRIDDEN by docker-compose.yml (constructed from
# MONGO_ROOT_USER/PASSWORD in the root .env, pointed at the mongo container).
# Set this only if running the sidecar standalone (e.g. local dev outside Docker).
MONGO_URI=

# ── Job scratch directory (optional — defaults to /tmp/jobs) ────────────────
# In Docker this is set to /app/tmp/jobs by docker-compose.yml. Override only
# if you want to mount an external volume for inspecting failed merge jobs.
# JOB_TMP_DIR=/tmp/jobs

# ── Logging level (optional) ────────────────────────────────────────────────
# LOG_LEVEL=INFO
